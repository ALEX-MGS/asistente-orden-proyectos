# --- Supabase (Settings → API) ---------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Proveedor del modelo --------------------------------------------
# 'openai' sirve para OpenAI y para todo lo compatible con su API
# (DeepSeek, Groq, Gemini, Mistral, xAI): sólo cambia BASE_URL y MODELO.
PROVEEDOR=openai
OPENAI_API_KEY=
MODELO=gpt-4o

# Sólo si usas un compatible que no es OpenAI:
#   DeepSeek  https://api.deepseek.com
#   Groq      https://api.groq.com/openai/v1
#   Gemini    https://generativelanguage.googleapis.com/v1beta/openai
BASE_URL=

# Para volver a Claude: PROVEEDOR=anthropic, MODELO=claude-sonnet-4-5
ANTHROPIC_API_KEY=

MAX_TOKENS=1200
HISTORIAL=12

# --- WhatsApp (Fase 1, sandbox de Twilio) ----------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# La URL pública EXACTA que pusiste en Twilio, con /whatsapp al final.
# Twilio firma esa URL; si aquí va otra, ninguna firma cuadra.
URL_PUBLICA=https://xxxx.ngrok-free.app/whatsapp
