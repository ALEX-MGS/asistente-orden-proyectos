# --- Supabase (Settings → API) ---------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Proveedor del modelo --------------------------------------------
# 'openai' sirve para OpenAI y para todo lo compatible con su API
# (DeepSeek, Groq, Gemini, Mistral, xAI): sólo cambia BASE_URL y MODELO.
PROVEEDOR=openai
OPENAI_API_KEY=
MODELO=gpt-4o

# Sólo si usas un compatible que no es OpenAI:
#   DeepSeek  https://api.deepseek.com
#   Groq      https://api.groq.com/openai/v1
#   Gemini    https://generativelanguage.googleapis.com/v1beta/openai
BASE_URL=

# Para volver a Claude: PROVEEDOR=anthropic, MODELO=claude-sonnet-4-5
ANTHROPIC_API_KEY=

# --- Tablero web ------------------------------------------------------
# Sin token, cualquiera con la URL ve tus obras y clientes. Invéntate una
# cadena larga: python -c "import secrets;print(secrets.token_urlsafe(24))"
TABLERO_TOKEN=
# El link completo que el asistente manda por WhatsApp, con el token:
TABLERO_URL=

MAX_TOKENS=1200
HISTORIAL=12

# --- WhatsApp (Fase 1, sandbox de Twilio) ----------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# La URL pública EXACTA que pusiste en Twilio, con /whatsapp al final.
# Twilio firma esa URL; si aquí va otra, ninguna firma cuadra.
URL_PUBLICA=https://xxxx.ngrok-free.app/whatsapp

# --- Notas de voz -----------------------------------------------------
# La transcripción la hace OpenAI aunque el chat lo atienda otro
# proveedor, así que necesita OPENAI_API_KEY puesta (arriba).
# whisper-1 se retira de la API el 26 de febrero de 2027; el reemplazo
# para audios grabados es gpt-transcribe, que además cuesta menos
# (unos 0.0045 USD por minuto). Déjalo vacío para usar el de default.
MODELO_VOZ=gpt-transcribe
# Sólo si transcribes con otro proveedor compatible con OpenAI:
BASE_URL_VOZ=

# --- Resumen de la mañana ---------------------------------------------
# Vacío = apagado. Pon la hora en 24 h, por ejemplo 08:47. Evita las
# horas en punto: a esa hora todo mundo tiene tareas programadas.
# Quién lo recibe sale de personas.resumen_diario, no de aquí:
#   update personas set resumen_diario = true where nombre = 'Beto';
RESUMEN_HORA=
ZONA=America/Mexico_City
